# Backend environment (copy to .env or export). All optional — sensible defaults apply.

# --- Database (garment service) ---
# Postgres via asyncpg. Backend auto-creates vton_* tables + seeds from catalog.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/doctor_appointment
GARMENT_TABLE_PREFIX=vton_

# --- Async job queue (HD try-on) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- HD inference engine: catvton | replicate | local | stub | idm_vton ---
HD_ENGINE=catvton
# REPLICATE_API_TOKEN=          # for HD_ENGINE=replicate (hosted IDM-VTON)
# CATVTON_REPO=/abs/path/CatVTON  # for HD_ENGINE=catvton
# HD_STEPS=30
# HD_GUIDANCE=2.5
# HD_IPADAPTER_SCALE=0.9

# --- Realism toggles (CPU) ---
TRYON_OCCLUDE=1     # forearms/hands in front of the garment
TRYON_LIGHTING=0    # match garment brightness to the scene
TRYON_TPS=0         # TPS sleeve refinement (tops)

# --- Paths (defaults are fine) ---
# ASSETS_DIR=../assets
# RESULTS_DIR=./storage/results
# UPLOADS_DIR=./storage/uploads
